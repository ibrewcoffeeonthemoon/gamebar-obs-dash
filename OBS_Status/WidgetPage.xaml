<Page
    x:Class="OBS_Status.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OBS_Status"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >
	<Button 
		x:Name="StatusButton"
		x:FieldModifier="public"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch"
		BorderThickness="0"
		CornerRadius="20"
		Padding="5"
		Click="StatusButton_Click"
		>
		<StackPanel
			Orientation="Horizontal"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			>
			<!-- Info Text -->
			<StackPanel
				x:Name="InfoTextPanel"
				x:FieldModifier="public"
				Orientation="Vertical"
				Padding="10 0 20 0"
				Visibility="Visible">
				<!-- Profile Name Text -->
				<TextBlock
					x:Name="ProfileNameText"
					x:FieldModifier="public"
					FontSize="13"
					FontWeight="Light"
					Foreground="LightGoldenrodYellow"
					Text="Profile - long long long profile name"
					/>
				<!-- Scene Name Text -->
				<TextBlock
					x:Name="SceneNameText"
					x:FieldModifier="public"
					FontSize="13"
					FontWeight="Light"
					Foreground="LightYellow"
					Text="Scene - long long scene name"
					/>
			</StackPanel>
			<!-- Status Text -->
			<TextBlock 
				x:Name="RecordingTimerText"
				x:FieldModifier="public"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Center"
				TextAlignment="Center"
				Foreground="White"
				FontSize="22"
				FontWeight="ExtraBold"
				Text="00:00:00"
				/>
		</StackPanel>
	</Button>
</Page>

