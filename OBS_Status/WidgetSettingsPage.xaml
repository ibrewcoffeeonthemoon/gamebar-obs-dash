<Page
    x:Class="OBS_Status.WidgetSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OBS_Status"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid Padding="12" ColumnSpacing="12">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="150" />
		</Grid.ColumnDefinitions>

		<Grid
			Grid.Column="0" >
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<!-- Log area (left) -->
			<ListView
				x:Name="LogListView"
				Grid.Row="0"
				RequestedTheme="Dark"
				SelectionMode="None">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="MinHeight" Value="0"/>
						<Setter Property="Padding" Value="0"/>
						<Setter Property="Margin" Value="0"/>
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.Footer>
					<Canvas Height="100" />
				</ListView.Footer>
				<ListView.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Text="{Binding}" 
							FontFamily="Consolas" 
							FontSize="12" 
							TextWrapping="Wrap" 
							Foreground="White"/>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<CheckBox 
				x:Name="AutoScrollCheckBox" 
				Grid.Row="1"
				Content="Auto-scroll" 
				IsChecked="True" 
				Margin="10,5"/>
		</Grid>

		<!-- Settings (right) -->
		<StackPanel
			Grid.Column="1"
			Spacing="8">
			<TextBox
				x:Name="AddressTextBox"
				Header="Address"
				PlaceholderText="127.0.0.1"
				GotFocus="OnFocus" />
			<TextBox
				x:Name="PortTextBox"
				Header="Port"
				PlaceholderText="4455"
				InputScope="Number"
				GotFocus="OnFocus" />
			<PasswordBox
				x:Name="PasswordBox"
				Header="Password"
				GotFocus="OnFocus" />
			<Button
				Content="Save"
				Click="OnSave"
				Margin="0,20,0,0"
				HorizontalAlignment="Stretch" />
		</StackPanel>
	</Grid>

</Page>
