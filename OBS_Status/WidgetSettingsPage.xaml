<Page
    x:Class="OBS_Status.WidgetSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OBS_Status"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<StackPanel
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		Width="260"
		Spacing="8">
		<TextBlock Text="OBS WebSocket Settings" />
		<TextBox
			x:Name="AddressTextBox"
			Header="Address"
			PlaceholderText="127.0.0.1"
			GotFocus="OnFocus"
			/>
		<TextBox
			x:Name="PortTextBox"
			Header="Port"
			PlaceholderText="4455"
			InputScope="Number"
			GotFocus="OnFocus"
			/>
		<PasswordBox
			x:Name="PasswordBox"
			Header="Password"
			GotFocus="OnFocus"
			/>
		<Button
			Content="Save"
			Click="OnSave"
			Padding="3"
			HorizontalAlignment="Stretch" 
			Margin="0,20,0,0" />
	</StackPanel>
</Page>
