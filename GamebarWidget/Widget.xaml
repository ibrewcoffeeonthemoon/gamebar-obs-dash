<Page
    x:Class="GamebarOBSDash.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GamebarOBSDash"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="150"
    Height="120">

    <Grid>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
			<TextBlock x:Name="txtOutput" FontSize="20"/>
			<TextBox x:Name="txtInput" PlaceholderText="Type message"/>
			<Button x:Name="myButton" Click="MyButton_Click">Connect</Button>
        </StackPanel>
    </Grid>
</Page>
